{
  "name": "pagestudio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build:published-styles": "node scripts/build-published-styles.mjs",
    "build": "npm run build:published-styles && tsc -b && vite build && npm run build:publish-renderer",
    "build:publish-renderer": "vite build --config vite.publish-renderer.config.ts",
    "check:layout": "npm run build:publish-renderer && node scripts/check-card-layout.mjs",
    "lint": "eslint .",
    "test": "vitest run && npm run build:publish-renderer && node scripts/check-published.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@measured/puck": "^0.20.2",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/js-cookie": "^3.0.6",
    "dompurify": "^3.3.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.553.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
