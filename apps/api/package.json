{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --check index.mjs && node --check src/server.mjs",
    "check": "node --check index.mjs && node --check src/server.mjs",
    "routes:extract": "node scripts/extract-routes.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "node --watch src/dev.mjs",
    "setup": "node scripts/local-setup.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.mjs",
    "db:push": "drizzle-kit push --config=drizzle.config.mjs",
    "seed": "npm run seed:users && npm run seed:taxonomies && npm run seed:assets && npm run seed:stories && npm run seed:pages && npm run seed:analytics && npm run seed:site-assets",
    "seed:users": "node --env-file=.env.local scripts/seed/users.mjs",
    "seed:taxonomies": "node --env-file=.env.local scripts/seed/taxonomies.mjs",
    "seed:assets": "node --env-file=.env.local scripts/seed/assets.mjs",
    "seed:stories": "node --env-file=.env.local scripts/seed/stories.mjs",
    "seed:pages": "node --env-file=.env.local scripts/seed/pages.mjs",
    "publish:login": "node --env-file=.env.local scripts/publish-login.mjs",
    "seed:site-assets": "node --env-file=.env.local scripts/seed/site-assets.mjs",
    "seed:analytics": "node --env-file=.env.local scripts/seed/analytics.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-mediaconvert": "^3.700.0",
    "@aws-sdk/client-rekognition": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@neon/config": "^1.7.0",
    "drizzle-kit": "^0.31.11"
  }
}
