# Local development defaults (copy to .env.local). Works with docker-compose.yml as-is.
PORT=3001
SITE_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
JWT_SECRET=local-dev-only-secret-change-me
CRON_SECRET=local-cron-secret
DATABASE_URL=postgres://openpress:openpress-local-secret@127.0.0.1:5432/openpress

# S3-compatible Object Storage (Local container, or Neon)
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY_ID=openpress
STORAGE_SECRET_ACCESS_KEY=openpress-local-secret
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
PUBLIC_STORAGE_URL=http://127.0.0.1:9000

# Bucket Names
DAM_BUCKET_NAME=openpress-dam
WEBSITE_BUCKET_NAME=openpress-website
ANALYSIS_BUCKET_NAME=openpress-analysis

# Site & Admin URLs
FRONTEND_URL=http://localhost:5173
FRONTEND_WEBSITE_URL=http://localhost:8080
SITE_URL=http://localhost:8080

# First Super User created by `npm run setup:local`
SEED_ADMIN_EMAIL=admin@openpress.local
SEED_ADMIN_PASSWORD=admin12345

# Local dev: path to the Page Studio renderer bundle
PUBLISH_RENDERER_FILE=../pagestudio/dist/publish-renderer.js

# Optional features (unset = off; endpoints return 503 if called when disabled)
# GEMINI_API_KEY=               # AI features (editorial tools, DAM search, survey summaries)
# GEMINI_MODEL=gemini-2.5-flash # AI model selection (default: gemini-2.5-flash)
# BRAVE_API_KEY=                # Web search for /research
# EMAIL_SENDER=             # Outbound emails (contact inquiries, survey invites)
# ENABLE_IMAGE_ANALYSIS=true       # Image/video tagging
# TRANSCODE_ENDPOINT=        # Video transcoding endpoint
# TRANSCODE_ROLE_ARN=        # Video transcoding role
# YOUPI_WEBHOOK_SECRET=         # YouPI payment gateway webhook secret

# Local only: unverified demo reader sign-in. Production uses Neon Auth (NEON_AUTH_BASE_URL) and ignores this.
EPAPER_DEMO_LOGIN=true
