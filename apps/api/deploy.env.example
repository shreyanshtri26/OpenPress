# Template for the GitHub secret API_ENV_FILE (Settings > Environments > production > Secrets).
# Paste the whole file, with your real values, as the secret's value. Never commit a filled-in copy.

# --- Required --------------------------------------------------------------
# Neon pooled connection string (postgres://...neon.tech/...?sslmode=require)
DATABASE_URL=
# long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# another long random string
CRON_SECRET=
# comma separated: the dashboard and the newspaper, e.g. https://openpress-publish.pages.dev,https://openpress-news.pages.dev
ALLOWED_ORIGINS=
# the dashboard address
FRONTEND_URL=
# the newspaper address
FRONTEND_WEBSITE_URL=
# the newspaper address (links written into published pages)
SITE_URL=

# --- Neon Object Storage (S3 compatible) -------------------------------------
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=             # the bucket endpoint from the Neon console
# public base URL of the buckets
PUBLIC_STORAGE_URL=
DAM_BUCKET_NAME=openpress-dam
WEBSITE_BUCKET_NAME=openpress-website

# --- Table names (keep as is) -----------------------------------------------
DOC_USERS_TABLE_NAME=op_users
DOC_ROLES_TABLE_NAME=op_roles
DOC_STORIES_TABLE_NAME=op_stories
DOC_ARTICLES_TABLE_NAME=op_articles
DOC_ASSETS_TABLE_NAME=op_assets
DOC_TAXONOMY_TABLE_NAME=op_taxonomy
DOC_PAGEBUILDER_TABLE_NAME=op_pagebuilder
DOC_CAMPAIGN_TABLE_NAME=op_campaigns
DOC_PLACEMENT_TABLE_NAME=op_placements
DOC_AUDIENCE_TABLE_NAME=op_audience
DOC_CONTACT_US_TABLE=op_contact_submissions
DOC_SEARCH_HISTORY_TABLE=op_searchhistory
DOC_SURVEY_TABLE_NAME=op_surveys
DOC_SURVEY_CHAT_TABLE_NAME=op_survey_chat
DOC_SUPPORTERS_TABLE=op_supporters

# --- Optional features (leave out to keep them off) --------------------------
# AI tools, library search, research
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# research search, used before Gemini when set
BRAVE_API_KEY=
# Support Us payments (YouPI PG webhook signature secret)
YOUPI_WEBHOOK_SECRET=
# contact form and survey emails (email)
EMAIL_SENDER=
