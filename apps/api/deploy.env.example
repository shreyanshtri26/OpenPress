# Template for the GitHub secret API_ENV_FILE (Settings > Environments > production > Secrets).
# Paste the whole file, with your real values, as the secret's value. Never commit a filled-in copy.

# --- Required --------------------------------------------------------------
# Neon pooled connection string (postgres://...neon.tech/...?sslmode=require)
DATABASE_URL=
# long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# another long random string
CRON_SECRET=
# comma separated: the dashboard and the newspaper, e.g. https://openpress-dashboard.pages.dev,https://openpress-site.<subdomain>.workers.dev
ALLOWED_ORIGINS=
# the dashboard address
FRONTEND_URL=
# the newspaper address
FRONTEND_WEBSITE_URL=
# the newspaper address (links written into published pages)
SITE_URL=

# --- Neon Object Storage (S3 compatible) -------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_OpenPress_REGION=us-east-1
AWS_ENDPOINT_URL_S3=             # the bucket endpoint from the Neon console
# public base URL of the buckets
PUBLIC_STORAGE_URL=
S3_DAM_BUCKET_NAME=openpress-dam
S3_WEBSITE_BUCKET_NAME=openpress-website

# --- Table names (keep as is) -----------------------------------------------
DYNAMO_USERS_TABLE_NAME=op_users
DYNAMO_ROLES_TABLE_NAME=op_roles
DYNAMO_STORIES_TABLE_NAME=op_stories
DYNAMO_ARTICLES_TABLE_NAME=op_articles
DYNAMO_ASSETS_TABLE_NAME=op_assets
DYNAMO_TAXONOMY_TABLE_NAME=op_taxonomy
DYNAMO_PAGEBUILDER_TABLE_NAME=op_pagebuilder
DYNAMO_CAMPAIGN_TABLE_NAME=op_campaigns
DYNAMO_PLACEMENT_TABLE_NAME=op_placements
DYNAMO_AUDIENCE_TABLE_NAME=op_audience
DYNAMO_CONTACT_US_TABLE=op_contact_submissions
DYNAMO_SEARCH_HISTORY_TABLE=op_searchhistory
DYNAMO_SURVEY_TABLE_NAME=op_surveys
DYNAMO_SURVEY_CHAT_TABLE_NAME=op_survey_chat
DYNAMO_SUPPORTERS_TABLE=op_supporters

# --- Optional features (leave out to keep them off) --------------------------
# AI tools, library search, research
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# research search, used before Gemini when set
BRAVE_API_KEY=
# Support Us payments (YouPI PG webhook signature secret)
YOUPI_WEBHOOK_SECRET=
# contact form and survey emails (AWS SES)
SES_SENDER_EMAIL=
